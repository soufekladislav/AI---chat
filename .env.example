# Fresh AI Engine
FRESH_ENGINE_URL=https://aiengine.freshcrackers.cz
FRESH_ENGINE_API_KEY=fai_REPLACE_WITH_ENGINE_API_KEY

# Chat behavior
FRESH_CHAT_QUALITY=balanced
FRESH_CHAT_MAX_OUTPUT_TOKENS=1800
FRESH_CHAT_SHOW_MODEL_META=true


# Optional custom system instruction
# FRESH_CHAT_SYSTEM_INSTRUCTION=...

# Personal accounts, SSO and MySQL / MariaDB (required by 0.3.1)
CHAT_PUBLIC_ORIGIN=https://chat.freshcrackers.cz
CHAT_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
CHAT_DB_HOST=localhost
CHAT_DB_PORT=3306
CHAT_DB_NAME=YOUR_DATABASE_NAME
CHAT_DB_USER=YOUR_DATABASE_USER
CHAT_DB_PASSWORD=YOUR_DATABASE_PASSWORD
FRESH_ACCOUNT_URL=https://www.freshcrackers.cz
FRESH_ACCOUNT_APP_ID=chat
FRESH_ACCOUNT_SECRET=REPLACE_WITH_DISTINCT_CHAT_APP_SECRET

# Recommended: dedicated Chat-to-Engine key that matches Engine FRESH_CHAT_ENGINE_KEY.
# Keep other providers' keys in Engine; do not store them in Chat.
# FRESH_ENGINE_API_KEY=fai_CREATE_A_SEPARATE_RANDOM_CHAT_ONLY_KEY

# Different from Chat->Engine key. Allows Engine read-only admin user statistics.
CHAT_REPORTING_SECRET=GENERATE_ANOTHER_UNIQUE_RANDOM_32_PLUS_CHAR_SECRET
